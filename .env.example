# Copy to .env and fill in with real values. .env is never committed (see .gitignore).

# DataHub's GMS (Graph Management Service) URL.
# If you ran `datahub docker quickstart` locally, the default value already works.
DATAHUB_GMS_URL=http://localhost:8080

# DataHub Personal Access Token (Settings -> Access Tokens in the UI).
# Not required for a local instance with no auth, but is for instances with login enabled.
DATAHUB_GMS_TOKEN=
