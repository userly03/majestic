# Copiar a .env y completar con los valores reales. .env nunca se commitea (ver .gitignore).

# URL del GMS (Graph Management Service) de DataHub.
# Si corriste `datahub docker quickstart` localmente, el valor por defecto ya sirve.
DATAHUB_GMS_URL=http://localhost:8080

# Personal Access Token de DataHub (Settings -> Access Tokens en la UI).
# No es obligatorio para una instancia local sin auth, pero sí para instancias con login habilitado.
DATAHUB_GMS_TOKEN=
